# Copy to .env.local for local development. Restart `npm run dev` after changes.

# Backend address (no trailing slash). Live Render URL, DECISIONS.md #5.
NEXT_PUBLIC_API_URL=https://frontdoor-api-hiel.onrender.com

# "true" = load example data from shared/mock/ instead of the live backend.
NEXT_PUBLIC_USE_MOCK=false

# AI Coach. Unset = the built-in sample coach (pre-written answers, no network call).
# "live" = ask the backend at NEXT_PUBLIC_API_URL/api/v1/coach (BACKEND_CONTRACT.md section 7f). The backend
# answers from Claude only when its own MOCK_MODE is false; otherwise it answers from your data in plain code.
NEXT_PUBLIC_COACH_MODE=
# Optional full URL that replaces the default backend coach endpoint, e.g. http://localhost:8000/api/v1/coach
NEXT_PUBLIC_COACH_ENDPOINT=
