# Copy this file to .env for local development. Never commit .env.
# MOCK_MODE=true serves seeded data and makes no AI calls.
MOCK_MODE=true
# Set the real key only in Render's dashboard or your local .env, never in the repo.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Extra allowed frontend URLs, comma-separated. localhost:3000 and *.vercel.app are always allowed.
FRONTEND_ORIGINS=
